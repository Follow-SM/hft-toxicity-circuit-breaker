# ENTERPRISE FollowSM API key: /ws/v1/toxicity and /ws/v1/confluence reject every other tier (HTTP 403).
# Get one at https://follow-sm.com/pricing
FOLLOWSM_API_KEY=

# Comma-separated Binance symbols to guard (empty = every symbol on the stream).
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Tick-level trip / re-arm thresholds (hysteresis band between them).
# vpin_percentile = VPIN ranked against the symbol's own recent history (0-1).
VPIN_PERCENTILE_TRIP=0.90
VPIN_PERCENTILE_REARM=0.80
# Raw-VPIN fallback, used only while the backend has not published vpin_percentile yet.
VPIN_TRIP=0.85
VPIN_REARM=0.75
OB_TOXICITY_TRIP=2.0
IMBALANCE_SPIKE=0.20
COOLDOWN_SECS=5

# Local fallback RiskConfig used to evaluate /ws/v1/confluence frames.
VPIN_PERCENTILE_WIDEN_THRESHOLD=0.90
VPIN_PERCENTILE_HALT_THRESHOLD=0.95
VPIN_WIDEN_THRESHOLD=0.80
VPIN_HALT_THRESHOLD=0.90
MIN_SEMANTIC_CONFIDENCE=0.65

# Optional: POST every risk transition here (e.g. your OMS kill-switch endpoint).
WEBHOOK_URL=
# Optional: HMAC-SHA256 key; the hex digest of the raw body is sent as X-FollowSM-Signature.
WEBHOOK_SECRET=
